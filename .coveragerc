[run]
branch = True
source = dcs
disable_warnings = include-ignored
omit =
    dcs/tests/*
    tests/*
    *test_*.py

[report]
fail_under = 100
show_missing = True
exclude_lines =
    pragma: no cover
    _NACL = True
    _HAS_NACL = True
include =
    dcs/verify.py
    dcs/verify_intoto.py
    dcs/mesh/behavior.py
    dcs/self.py
    dcs/crosscut/semver.py
    dcs/__main__.py
    dcs/conform.py
